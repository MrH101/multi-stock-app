# Copy to .env and change every value before deploying.
ENVIRONMENT=development
JWT_SECRET=dev-only-change-me-dev-only-change-me
SERVICE_TOKEN=dev-service-token
POSTGRES_PASSWORD=multistock
ADMIN_EMAIL=admin@multistock.app
ADMIN_PASSWORD=ChangeMe123!
# Monitoring agent: Caimex model gateway key (https://api.caimex.ai). Leave empty to run with
# rule-based briefings only; the monitoring and notifications still work without it.
CAIMEX_API_KEY=
CAIMEX_MODEL=gpt-5.4-mini-2026-03-17
MONITOR_INTERVAL_SECONDS=900
# Payments: Fernet key that encrypts suppliers' Paynow keys. Generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENTS_SECRET_KEY=
# Public https origin Paynow calls back to (result URL) and returns customers to.
PUBLIC_BASE_URL=http://localhost:8080
